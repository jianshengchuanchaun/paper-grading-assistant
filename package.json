{
  "name": "paper-grading-assistant",
  "version": "2.3.0",
  "private": true,
  "description": "GradeFlow / 阅卷有方 — a bilingual, teacher-reviewed paper grading workspace",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/server.mjs",
    "dev": "node --env-file-if-exists=.env scripts/server.mjs",
    "build": "npm run build:ui && node scripts/build.mjs",
    "test": "node --test tests/core.test.cjs tests/library.test.cjs tests/server.test.cjs",
    "test:ui": "playwright test",
    "format": "prettier --write assets/*.js assets/styles.css assets/redesign.css src scripts tests index.html package.json tsconfig.json vite.config.mts playwright.config.cjs .github",
    "check": "npm run check:types && node --check assets/app.js && node --check assets/core.js && node --check assets/i18n.js && node --check assets/comments.js && node --check assets/library.js && npm test",
    "build:ui": "vite build",
    "check:types": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "1.72.0",
    "motion": "14.13.0",
    "pdfjs-dist": "6.5.438",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
